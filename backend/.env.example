# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Baza (Neon PostgreSQL) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---- Telegram bot (@BotFather dan oling) ----
BOT_TOKEN=123456789:AA...
# Buyurtmalar keladigan Telegram ID(lar) — vergul bilan. Guruh ID ham bo'lishi mumkin (-100...)
ADMIN_CHAT_IDS=123456789
# Webhook so'rovlarini tekshirish uchun maxfiy kalit (ixtiyoriy tasodifiy satr)
WEBHOOK_SECRET=change-me

# ---- Mini App manzili (frontend) ----
# Telegram'da web_app tugmalari faqat https bilan ishlaydi (Vercel domeni)
WEBAPP_URL=https://mira-kosmetika-app.vercel.app

# ---- Admin panel ----
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
